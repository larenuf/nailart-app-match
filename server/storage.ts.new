    // Create sample time slots for all artists, covering the next 30 days
    const startDate = new Date();
    const endDate = new Date();
    endDate.setDate(endDate.getDate() + 30);
    
    let currentId = 1;
    const artistIds = [1, 2, 3, 4];
    
    for (const artistId of artistIds) {
      // For each day in the date range
      for (let d = new Date(startDate); d <= endDate; d.setDate(d.getDate() + 1)) {
        const currentDay = new Date(d);
        
        // Create 3 random time slots per day (9am, 12pm, 3pm)
        const morningSlot = new Date(currentDay.setHours(9, 0, 0));
        this.timeSlots.set(currentId, {
          id: currentId,
          artistId,
          date: new Date(morningSlot),
          startTime: '9:00 AM',
          isBooked: false
        });
        currentId++;
        
        const noonSlot = new Date(currentDay.setHours(12, 0, 0));
        this.timeSlots.set(currentId, {
          id: currentId,
          artistId,
          date: new Date(noonSlot),
          startTime: '12:00 PM',
          isBooked: false
        });
        currentId++;
        
        const afternoonSlot = new Date(currentDay.setHours(15, 0, 0));
        this.timeSlots.set(currentId, {
          id: currentId,
          artistId,
          date: new Date(afternoonSlot),
          startTime: '3:00 PM',
          isBooked: false
        });
        currentId++;
      }
    }
    
    this.timeSlotIdCounter = currentId;
